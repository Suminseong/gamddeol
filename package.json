{
  "name": "gamddeol",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "감떨 알파: 브라우저에서 OpenAI Responses API로 원고 감평을 요청하는 개인 검증용 웹앱",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "poc:readers": "node experiments/virtual-readers/run.ts",
    "typecheck:experiments": "tsc --noEmit -p experiments/tsconfig.json",
    "test:experiments": "vitest run --config experiments/vitest.config.ts",
    "check:experiments": "npm run typecheck:experiments && npm run test:experiments && npm run poc:readers"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
